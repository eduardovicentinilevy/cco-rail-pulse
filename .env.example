# ==========================================================
# RailPulse CCO — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env preenchido.
# ==========================================================

NODE_ENV=development
PORT=3333
# Versão publicada — o Docker preenche via build arg; aparece no /health e nos logs.
APP_VERSION=dev

# --- Observabilidade -------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# json (produção, pronto para agregador) | pretty (terminal)
LOG_FORMAT=pretty

# --- Banco de dados -------------------------------------
# Use DATABASE_URL OU as variáveis individuais abaixo.
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/railpulse_cco
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=troque-esta-senha
DB_NAME=railpulse_cco

# --- Segurança ------------------------------------------
# Obrigatório quando NODE_ENV=production (o boot falha sem ele).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=60000

# Origens liberadas no CORS, separadas por vírgula. Vazio = libera todas (apenas dev).
CORS_ORIGIN=http://localhost:5173

# --- Banco: migrações e carga inicial --------------------
# Aplica as migrações pendentes no boot. Desligue quando o deploy roda
# `npm run migrate` como passo próprio (várias réplicas, deploy gradual).
DB_MIGRATE_ON_BOOT=true
# Semeia operador de demonstração, equipe e composições.
# Deixe false em produção real: essas credenciais são públicas.
DB_SEED_ON_BOOT=true

# --- Operação -------------------------------------------
TELEMETRY_INTERVAL_MS=3000
# Janela de agregação e retenção da série histórica de tensão.
TELEMETRY_BUCKET_SECONDS=60
TELEMETRY_RETENTION_DAYS=7

SEED_OPERATOR_ID=EDP-042
SEED_OPERATOR_NAME=Eduardo Vicentini Levy
# Obrigatório em produção, e não pode ficar no valor padrão: o boot falha.
SEED_OPERATOR_PASSWORD=123456
# OPERADOR | SUPERVISOR | ADMIN
SEED_OPERATOR_ROLE=SUPERVISOR

# --- Docker Compose --------------------------------------
# Porta em que o console web (nginx) é publicado no host.
WEB_PORT=8080
