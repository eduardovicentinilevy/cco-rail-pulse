# ==========================================================
# RailPulse CCO — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env preenchido.
# ==========================================================

NODE_ENV=development
PORT=3333

# --- Banco de dados -------------------------------------
# Use DATABASE_URL OU as variáveis individuais abaixo.
# DATABASE_URL=postgresql://postgres:senha@localhost:5432/railpulse_cco
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=troque-esta-senha
DB_NAME=railpulse_cco

# --- Segurança ------------------------------------------
# Obrigatório quando NODE_ENV=production (o boot falha sem ele).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade do access token. Curta de propósito: o painel renova sozinho pelo
# refresh token antes de vencer.
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
# Comprimento mínimo da senha. Valores abaixo de 12 são ignorados.
PASSWORD_MIN_LENGTH=12

# --- Sessões (refresh e revogação) ----------------------
# Janela deslizante do refresh token, renovada a cada uso.
REFRESH_TOKEN_TTL_DAYS=7
# Teto absoluto da sessão: nem com uso contínuo o refresh sobrevive além disso.
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
# Tolerância para duas abas renovarem ao mesmo tempo. Fora dela, reapresentar um
# refresh token já usado é tratado como token vazado e derruba a sessão.
REFRESH_REUSE_GRACE_SECONDS=20
# Validade dos tokens das etapas intermediárias do login.
MFA_CHALLENGE_EXPIRES_IN=5m
PASSWORD_CHANGE_EXPIRES_IN=10m

# --- Rate limit -----------------------------------------
# `postgres` (padrão) mantém o limite válido com várias instâncias atrás do
# balanceador; `memory` só serve a um processo isolado.
RATE_LIMIT_STORE=postgres
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=60000
# Teto global por origem, aplicado a toda a API.
API_MAX_REQUESTS=600
API_WINDOW_MS=60000

# Origens liberadas no CORS, separadas por vírgula. Vazio = libera todas (apenas dev).
CORS_ORIGIN=http://localhost:5173

# --- Operação -------------------------------------------
TELEMETRY_INTERVAL_MS=3000
# Janela de agregação e retenção da série histórica de tensão.
TELEMETRY_BUCKET_SECONDS=60
TELEMETRY_RETENTION_DAYS=7

SEED_OPERATOR_ID=EDP-042
SEED_OPERATOR_NAME=Eduardo Vicentini Levy
# OPERADOR | SUPERVISOR | ADMIN
SEED_OPERATOR_ROLE=SUPERVISOR

# Senha do operador inicial. NÃO há valor padrão: deixando em branco, o primeiro
# boot sorteia uma senha forte e a imprime uma única vez no log. Se preencher,
# ela precisa passar pela política (12+ caracteres, maiúscula, minúscula, número
# e símbolo). Nos dois casos a troca é exigida no primeiro acesso.
SEED_OPERATOR_PASSWORD=

# Equipe fictícia de vitrine (senhas aleatórias, sem login utilizável).
# Padrão: ativa fora de produção.
SEED_DEMO_TEAM=true
