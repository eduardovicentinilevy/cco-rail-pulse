# URL do backend RailPulse CCO (REST + WebSocket).
# Em desenvolvimento pode ficar vazio: o Vite faz proxy de /api e /socket.io
# para VITE_BACKEND_ORIGIN (padrão http://localhost:3333).
VITE_API_URL=

# Alvo do proxy do Vite durante o desenvolvimento.
VITE_BACKEND_ORIGIN=http://localhost:3333

# Exibe o campo "Cliente" na tela de acesso. Deixe desligado quando a instalação
# serve um cliente só ou quando o cliente vem do subdomínio.
VITE_TENANT_PROMPT=false
