{
  "name": "cco-rail-pulse",
  "version": "1.0.0",
  "description": "RailPulse CCO \u2014 Centro de Controle Operacional da Linha 6-Laranja (backend Node/Express + PostgreSQL)",
  "main": "backend/dist/presentation/http/server.js",
  "scripts": {
    "dev": "tsx watch backend/presentation/http/server.ts",
    "build": "rimraf backend/dist && tsc -p backend/tsconfig.json && node scripts/copy-sql.mjs",
    "start": "node backend/dist/presentation/http/server.js",
    "migrate": "tsx backend/infrastructure/database/migrate.cli.ts up",
    "migrate:status": "tsx backend/infrastructure/database/migrate.cli.ts status",
    "seed": "tsx backend/infrastructure/database/migrate.cli.ts seed",
    "typecheck": "tsc -p backend/tsconfig.test.json",
    "test": "tsx --test backend/tests/*.test.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "check": "npm run typecheck && npm test && npm run frontend:lint && npm run frontend:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
